<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Manifiesto de privacidad (App Store). Keyla, 20 Nov 2026.
     Sin rastreo publicitario. Datos solo para que la app funcione:
     cuenta (nombre, teléfono, correo, ID), ubicación precisa (lugares cercanos),
     fotos, audios y mensajes que el usuario publica, ID del dispositivo (sesión).
     API con motivo: UserDefaults (CA92.1, datos de la propia app). -->
