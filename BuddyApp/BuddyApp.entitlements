<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links de los lugares compartidos.
	     Los dos hosts: los enlaces se comparten con www, pero alguien puede
	     escribir el dominio a secas y iOS compara el host EXACTO — sin el apex
	     declarado, ese enlace abriría Safari.
	     Cada host tiene que servir su propio /.well-known/apple-app-site-association
	     por HTTPS y SIN redirección. Un 301 de apex a www basta para que iOS
	     descarte el archivo, y no avisa: el enlace simplemente deja de abrir
	     la app. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:buddyapp.biz</string>
		<string>applinks:www.buddyapp.biz</string>
	</array>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
